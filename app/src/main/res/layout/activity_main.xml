<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/flashButton"
            style="@style/TopLabel"
            android:text="Flash off" />

        <TextView
            android:id="@+id/timerButton"
            style="@style/TopLabel"
            android:text="Timer off" />

        <TextView
            android:id="@+id/gridButton"
            style="@style/TopLabel"
            android:text="Grid off" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="52dp"
        android:background="@color/well">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <app.frame.camera.GridOverlay
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/referenceImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <View
            android:id="@+id/focusRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0"
            android:background="@drawable/chip_off" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/bone"
            android:textSize="110sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/hint_bg"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/adjust_hint"
            android:textColor="@color/bone"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zoomText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/hint_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="1.0x"
            android:textColor="@color/bone"
            android:textSize="12sp" />

        <View
            android:id="@+id/touchSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="212dp"
        android:layout_gravity="bottom"
        android:background="@color/panel"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabFilter"
                style="@style/Tab"
                android:text="@string/tab_filter" />

            <TextView
                android:id="@+id/tabReference"
                style="@style/Tab"
                android:text="@string/tab_reference" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <HorizontalScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/referencePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/uploadButton"
                    style="@style/Chip"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/upload_reference" />

                <LinearLayout
                    android:id="@+id/refControls"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/opacity"
                            android:textAllCaps="true"
                            android:textColor="@color/dim"
                            android:textSize="11sp" />

                        <SeekBar
                            android:id="@+id/opacitySeek"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="45"
                            android:progressTint="@color/brass"
                            android:thumbTint="@color/brass" />

                        <TextView
                            android:id="@+id/opacityValue"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:text="45%"
                            android:textColor="@color/bone"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/adjustButton"
                            style="@style/Chip"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/adjust" />

                        <TextView
                            android:id="@+id/mirrorButton"
                            style="@style/Chip"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/mirror" />

                        <TextView
                            android:id="@+id/replaceButton"
                            style="@style/Chip"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/replace" />

                        <TextView
                            android:id="@+id/removeButton"
                            style="@style/Chip"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="@string/remove" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="28dp"
                android:background="@drawable/chip_off"
                android:contentDescription="@string/last_photo"
                android:padding="1dp"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_outer"
                android:contentDescription="@string/shutter">

                <View
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner" />
            </FrameLayout>

            <TextView
                android:id="@+id/flipButton"
                style="@style/Chip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="28dp"
                android:text="@string/flip" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
